<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="assistive_gaze_world">

    <include>
      <uri>model://ground_plane</uri>
    </include>

    <include>
      <uri>model://sun</uri>
    </include>

    <!-- Table -->
    <model name="assistive_table">
      <static>true</static>
      <pose>1.2 0 0.4 0 0 0</pose>

      <link name="table_link">
        <visual name="table_visual">
          <geometry>
            <box>
              <size>1.2 0.8 0.08</size>
            </box>
          </geometry>
          <material>
            <ambient>0.45 0.28 0.12 1</ambient>
          </material>
        </visual>

        <collision name="table_collision">
          <geometry>
            <box>
              <size>1.2 0.8 0.08</size>
            </box>
          </geometry>
        </collision>
      </link>
    </model>

    <!-- Selectable Object 1 -->
    <model name="red_cube">
      <pose>0.9 -0.25 0.48 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>0.2</mass>
        </inertial>

        <visual name="visual">
          <geometry>
            <box>
              <size>0.08 0.08 0.08</size>
            </box>
          </geometry>
          <material>
            <ambient>1 0 0 1</ambient>
          </material>
        </visual>

        <collision name="collision">
          <geometry>
            <box>
              <size>0.08 0.08 0.08</size>
            </box>
          </geometry>
        </collision>
      </link>
    </model>

    <!-- Selectable Object 2 -->
    <model name="blue_cube">
      <pose>0.9 0.25 0.48 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>0.2</mass>
        </inertial>

        <visual name="visual">
          <geometry>
            <box>
              <size>0.08 0.08 0.08</size>
            </box>
          </geometry>
          <material>
            <ambient>0 0 1 1</ambient>
          </material>
        </visual>

        <collision name="collision">
          <geometry>
            <box>
              <size>0.08 0.08 0.08</size>
            </box>
          </geometry>
        </collision>
      </link>
    </model>

    <!-- Place Zone -->
    <model name="place_zone">
      <static>true</static>
      <pose>1.45 0 0.455 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <cylinder>
              <radius>0.12</radius>
              <length>0.01</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0 1 0 0.8</ambient>
          </material>
        </visual>
      </link>
    </model>
    
    <!-- Overhead Camera -->
    <model name="overhead_camera">
      <static>true</static>
      <pose>1.1 0 1.6 0 1.5708 0</pose>

      <link name="overhead_camera_link">
        <sensor name="overhead_camera_sensor" type="camera">
          <always_on>true</always_on>
          <update_rate>30</update_rate>
          <visualize>true</visualize>

          <camera>
            <horizontal_fov>1.3962634</horizontal_fov>
            <image>
              <width>640</width>
              <height>480</height>
              <format>R8G8B8</format>
            </image>
            <clip>
              <near>0.05</near>
              <far>10.0</far>
            </clip>
          </camera>

          <plugin name="overhead_camera_controller" filename="libgazebo_ros_camera.so">
            <ros>
              <namespace>/overhead_camera</namespace>
            </ros>
            <camera_name>overhead_camera</camera_name>
            <frame_name>overhead_camera_link</frame_name>
          </plugin>
        </sensor>
      </link>
    </model>

  </world>
</sdf>
