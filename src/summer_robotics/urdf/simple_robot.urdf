<?xml version="1.0"?>
<robot name="two_link_robot">

  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.05"/>
      <geometry>
        <box size="0.4 0.4 0.1"/>
      </geometry>
      <material name="blue">
        <color rgba="0.1 0.2 0.8 1.0"/>
      </material>
    </visual>

    <collision>
      <origin xyz="0 0 0.05"/>
      <geometry>
        <box size="0.4 0.4 0.1"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0.05"/>
      <mass value="20.0"/>
      <inertia
        ixx="1.0" ixy="0.0" ixz="0.0"
        iyy="1.0" iyz="0.0"
        izz="1.0"/>
    </inertial>
  </link>

  <link name="link_1">
    <visual>
      <origin xyz="0 0 0.5"/>
      <geometry>
        <cylinder radius="0.1" length="1.0"/>
      </geometry>
      <material name="green">
        <color rgba="0.1 0.8 0.2 1.0"/>
      </material>
    </visual>

    <collision>
      <origin xyz="0 0 0.5"/>
      <geometry>
        <cylinder radius="0.1" length="1.0"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0.5"/>
      <mass value="1.5"/>
      <inertia
        ixx="0.1" ixy="0.0" ixz="0.0"
        iyy="0.1" iyz="0.0"
        izz="0.02"/>
    </inertial>
  </link>

  <link name="link_2">
    <visual>
      <origin xyz="0 0 0.4"/>
      <geometry>
        <cylinder radius="0.08" length="0.8"/>
      </geometry>
      <material name="orange">
        <color rgba="1.0 0.5 0.1 1.0"/>
      </material>
    </visual>

    <collision>
      <origin xyz="0 0 0.4"/>
      <geometry>
        <cylinder radius="0.08" length="0.8"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0.4"/>
      <mass value="1.0"/>
      <inertia
        ixx="0.05" ixy="0.0" ixz="0.0"
        iyy="0.05" iyz="0.0"
        izz="0.01"/>
    </inertial>
  </link>

  <link name="end_effector_link">
    <visual>
      <origin xyz="0 0 0.075"/>
      <geometry>
        <cylinder radius="0.03" length="0.15"/>
      </geometry>
      <material name="red_tool">
        <color rgba="1.0 0.0 0.0 1.0"/>
      </material>
    </visual>

    <collision>
      <origin xyz="0 0 0.075"/>
      <geometry>
        <cylinder radius="0.03" length="0.15"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0.075"/>
      <mass value="0.1"/>
      <inertia
        ixx="0.001" ixy="0.0" ixz="0.0"
        iyy="0.001" iyz="0.0"
        izz="0.001"/>
    </inertial>
  </link>

  <joint name="joint_1" type="revolute">
    <parent link="base_link"/>
    <child link="link_1"/>
    <origin xyz="0 0 0.1" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.57" upper="1.57" effort="100" velocity="1.0"/>
  </joint>

  <joint name="joint_2" type="revolute">
    <parent link="link_1"/>
    <child link="link_2"/>
    <origin xyz="0 0 1.0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.5" upper="2.5" effort="100" velocity="1.0"/>
  </joint>

  <joint name="end_effector_fixed_joint" type="fixed">
    <parent link="link_2"/>
    <child link="end_effector_link"/>
    <origin xyz="0 0 0.8" rpy="0 0 0"/>
  </joint>

  <gazebo>
    <plugin name="gazebo_ros2_control" filename="libgazebo_ros2_control.so">
      <parameters>/home/sri/summer_robotics_ws/src/summer_robotics/config/controllers.yaml</parameters>
    </plugin>
  </gazebo>

  <ros2_control name="GazeboSystem" type="system">
    <hardware>
      <plugin>gazebo_ros2_control/GazeboSystem</plugin>
    </hardware>

    <joint name="joint_1">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="joint_2">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>

</robot>
